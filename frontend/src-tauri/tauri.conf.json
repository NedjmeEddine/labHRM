{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EL-AMEL LAB",
  "version": "1.0.0",
  "identifier": "com.elamel-lab.hrm",
  "build": {
    "frontendDist": "../../backend/app/frontend",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EL-AMEL LAB",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NedjmeEddine/labHRM/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNDE1MEUzN0EyQzExODIKUldTQ0VTeDY0MUJCVVh5a0hKamdrNktOMEdPbC9idDhzSm1IWFVuSHlFc2hOMGdSRU44TG1ScmMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/el-amel-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
